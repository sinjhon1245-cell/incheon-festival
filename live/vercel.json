{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "sh build.sh",
  "outputDirectory": "dist",
  "ignoreCommand": "P=$VERCEL_GIT_PREVIOUS_SHA;C=$VERCEL_GIT_COMMIT_SHA;[ -n \"$P\" ]&&[ \"$P\" != \"$C\" ]&&git cat-file -e \"$P^{commit}\" 2>/dev/null&&git diff --quiet \"$P\" \"$C\" -- . ../visitor.html ../booth-ctrl.html ../assets&&exit 0;exit 1",
  "cleanUrls": false,
  "functions": {
    "api/live-snapshot.mjs": { "maxDuration": 10 }
  },
  "rewrites": [
    { "source": "/visitor.html", "destination": "/index.html" },
    { "source": "/booth-ctrl", "destination": "/booth-ctrl.html" },
    { "source": "/example", "destination": "/example/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "geolocation=(), microphone=(), camera=()" }
      ]
    },
    {
      "source": "/((?!booth-ctrl(?:\\.html)?$).*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/visitor.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/booth-ctrl.html",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/booth-ctrl",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
